# DEMONSTRATION ONLY. Never use demo authentication on a reachable interface.
APP_ENV=development
DEV_AUTH=true
LISTEN_ADDR=127.0.0.1:8071
DATABASE_URL=postgres://visual:visualdev@127.0.0.1:5432/visual?sslmode=disable

# Optional M2 private quarantine bucket. Bucket must already exist and have no
# public/unreviewed bucket policy. No presigned URL is exposed by this API.
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=replace-with-quarantine-writer
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=visual-quarantine
S3_REGION=us-east-1
S3_USE_SSL=false
MAX_UPLOAD_BYTES=104857600
