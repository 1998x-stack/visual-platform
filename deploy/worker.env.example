# Example only; never commit actual secrets. Use 0600 on loaded secret files.
DATABASE_URL=postgres://visual:REPLACE_ME@127.0.0.1:5432/visual?sslmode=disable

# Dedicated Worker credential restricted to: s3:GetObject quarantine/*.
# The management API uses separate Put/Delete credentials.
S3_ENDPOINT=127.0.0.1:9000
S3_BUCKET=visual-quarantine
S3_REGION=
S3_USE_SSL=true
WORKER_S3_ACCESS_KEY=REPLACE_READ_ONLY_ACCESS_KEY
WORKER_S3_SECRET_KEY=REPLACE_READ_ONLY_SECRET_KEY

# Local Unix socket (mounted into worker container or host).
CLAMD_SOCKET=/run/clamav/clamd.sock

# Must exist, be owned by the worker UID, 0700 and NOT a shared /tmp.
WORKER_TEMP_DIR=/var/lib/visual-platform/worker-spool

# Only for isolated development with loopback S3 endpoint:
# APP_ENV=development
# S3_USE_SSL=false
